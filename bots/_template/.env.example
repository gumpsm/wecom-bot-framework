# ============================================
# <Bot 名称> — 环境变量模板
# 复制为 .env 并填入真实值（.env 已在 .gitignore 中）
# 新 Bot 创建步骤：cp .env.example .env && 编辑 .env
# ============================================

# --- 企业微信机器人凭据 ---
# 获取方式：企业微信管理后台 → 智能机器人 → 配置页面
WECOM_BOT_ID=your_bot_id_here
WECOM_BOT_SECRET=your_bot_secret_here

# --- LLM API 配置（本 Bot 专用）---
# 支持 OpenAI 兼容协议的任何模型（DeepSeek / 智谱 / Qwen / 等）
# 支持 1-3 个 Key 轮换，至少填 1 个
DEEPSEEK_API_KEY_1=your_key_here
# DEEPSEEK_API_KEY_2=your_key_here
# DEEPSEEK_API_KEY_3=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

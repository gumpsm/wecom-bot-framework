# ============================================
# 党建助手 Bot — 环境变量模板
# 复制为 .env 并填入真实值（.env 已在 .gitignore 中）
# ============================================

# --- 企业微信机器人凭据（部署时替换为实际 Bot 的 ID 和 Secret）---
WECOM_BOT_ID=your_party_bot_id_here
WECOM_BOT_SECRET=your_party_bot_secret_here

# --- LLM API 配置（本 Bot 专用）---
DEEPSEEK_API_KEY_1=your_key_here
# DEEPSEEK_API_KEY_2=your_key_here
# DEEPSEEK_API_KEY_3=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

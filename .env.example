# ============================================================
# 本地开发：只启动自己的 Bot（逗号分隔），留空或不设=全部启动
BOT_FILTER=

# 企业微信智能机器人框架 — 统一环境变量
#
# 使用方法: cp .env.example .env  然后填入真实值
# .env 在 .gitignore 中，不会被提交到 Git
#
# 格式: 每个 Bot 一个配置块（凭据 + LLM + 部署）
# ============================================================


# ============================================================
# pa-bot（PA 架构师 — 框架测试专用）
# ============================================================
WECOM_PA_BOT_ID=your_bot_id_here
WECOM_PA_BOT_SECRET=your_bot_secret_here
# LLM 供应商: deepseek | minimax | glm | qwen
PA_BOT_LLM=deepseek
# --- 部署目标（DEV=本地开发，PROD=生产服务器）---
PA_BOT_HOST_DEV=localhost
# PA_BOT_HOST_PROD=your.server.ip
# PA_BOT_SSH_KEY_PROD=/path/to/key.pem


# ============================================================
# party-bot（党建助手）
# ============================================================
WECOM_PARTY_BOT_ID=your_bot_id_here
WECOM_PARTY_BOT_SECRET=your_bot_secret_here
PARTY_BOT_LLM=deepseek
# --- 部署目标 ---
PARTY_BOT_HOST_DEV=localhost
# PARTY_BOT_HOST_PROD=your.server.ip
# PARTY_BOT_SSH_KEY_PROD=/path/to/key.pem


# ============================================================
# project-bot（项目管理助手）
# ============================================================
WECOM_PROJECT_BOT_ID=your_bot_id_here
WECOM_PROJECT_BOT_SECRET=your_bot_secret_here
PROJECT_BOT_LLM=minimax
# --- 部署目标 ---
PROJECT_BOT_HOST_DEV=localhost
# PROJECT_BOT_HOST_PROD=your.server.ip
# PROJECT_BOT_SSH_KEY_PROD=/path/to/key.pem


# ============================================================
# LLM 供应商密钥池（上面各 Bot 通过 *_BOT_LLM 选用）
# ============================================================

# --- DeepSeek ---
DEEPSEEK_KEY_1=sk-your_key_here
DEEPSEEK_KEY_2=sk-your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# --- MiniMax ---
# MINIMAX_KEY_1=your_key_here
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=abab6.5s-chat

# --- 智谱 GLM ---
# GLM_KEY_1=your_key_here
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4

# --- 私有化 Qwen ---
# QWEN_KEY_1=your_key_here
# QWEN_BASE_URL=http://your-server:8080/v1
# QWEN_MODEL=qwen3.6-72b

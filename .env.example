# ============================================
# 企业微信智能机器人框架 — 环境变量模板
# 复制此文件为 .env 并填入真实值
# .env 已在 .gitignore 中，不会被提交到 Git
# ============================================

# --- 企业微信智能机器人凭据（必填）---
# 获取方式：企业微信管理后台 → 智能机器人 → 配置页面
WECOM_CORP_ID=your_corp_id_here
WECOM_BOT_ID=your_bot_id_here
WECOM_BOT_SECRET=your_bot_secret_here

# --- LLM API Keys（至少一个）---
# 支持 OpenAI 兼容协议的任何模型（DeepSeek / 智谱 / Qwen / 等）
DEEPSEEK_API_KEY_1=sk-your_key_1_here
DEEPSEEK_API_KEY_2=sk-your_key_2_here
DEEPSEEK_API_KEY_3=sk-your_key_3_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- 可选：其他模型 ---
# GLM_API_KEY=your_glm_key_here
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# QWEN_API_KEY=your_qwen_key_here
# QWEN_BASE_URL=http://your_private_server/v1

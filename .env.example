# ============================================
# 企业微信智能机器人框架 — 统一环境变量模板
# 
# 使用方法:
#   1. 复制本文件为 .env:  cp .env.example .env
#   2. 填入真实凭据
#   3. .env 已被 .gitignore 排除，不会提交到 Git
#
# 命名规则:
#   Bot 凭据:   WECOM_{BOT_NAME}_BOT_ID / _BOT_SECRET
#              BOT_NAME = 目录名大写+下划线 (pa-bot → PA_BOT)
#   LLM 供应商: {PROVIDER}_KEY_N / _BASE_URL / _MODEL
#              PROVIDER = DEEPSEEK / MINIMAX / GLM / QWEN
# ============================================

# ============================================
# 一、企业微信机器人凭据（每个 Bot 独立）
# ============================================

# --- pa-bot（本地开发测试专用）---
WECOM_PA_BOT_ID=your_test_bot_id_here
WECOM_PA_BOT_SECRET=your_test_bot_secret_here

# --- party-bot（党建助手）---
WECOM_PARTY_BOT_ID=your_party_bot_id_here
WECOM_PARTY_BOT_SECRET=your_party_bot_secret_here

# --- project-bot（项目管理助手）---
WECOM_PROJECT_BOT_ID=your_project_bot_id_here
WECOM_PROJECT_BOT_SECRET=your_project_bot_secret_here

# 新增 Bot 时按同样规则添加:
# WECOM_{BOT_NAME}_BOT_ID=xxx
# WECOM_{BOT_NAME}_BOT_SECRET=xxx


# ============================================
# 二、LLM 大模型供应商池（Bot 在 config.json 中选用）
# ============================================

# --- DeepSeek ---
DEEPSEEK_KEY_1=sk-your_deepseek_key_1_here
DEEPSEEK_KEY_2=sk-your_deepseek_key_2_here
# DEEPSEEK_KEY_3=sk-your_deepseek_key_3_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# --- MiniMax（OpenAI 兼容协议）---
# MINIMAX_KEY_1=your_minimax_key_here
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=abab6.5s-chat

# --- 智谱 GLM（OpenAI 兼容协议）---
# GLM_KEY_1=your_glm_key_here
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4

# --- 私有化部署 Qwen / 其他 OpenAI 兼容服务 ---
# QWEN_KEY_1=your_qwen_key_here
# QWEN_BASE_URL=http://10.0.0.100:8080/v1
# QWEN_MODEL=qwen3.6-72b

# 新增供应商时按同样规则添加:
# {PROVIDER}_KEY_1=xxx
# {PROVIDER}_BASE_URL=xxx
# {PROVIDER}_MODEL=xxx


# ============================================
# 三、部署服务器配置（PA 专用）
# ============================================

# --- 腾讯云轻量服务器 ---
# DEPLOY_HOST=your.server.ip
# DEPLOY_USER=ubuntu
# DEPLOY_SSH_KEY=/path/to/your/ssh-key.pem

# 多 Bot 可能部署到不同服务器时：
# DEPLOY_PARTY_BOT_HOST=xxx
# DEPLOY_PROJECT_BOT_HOST=xxx
